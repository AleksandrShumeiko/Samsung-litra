<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#5A3218"
                android:centerColor="#8A552C"
                android:endColor="#3D200F" />
        </shape>
    </item>

    <item android:top="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#55D49A5C" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <item android:top="18dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#5530180A" />
        </shape>
    </item>

    <item android:top="48dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#44D9A066" />
        </shape>
    </item>

    <item android:top="82dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#6630180A" />
        </shape>
    </item>

    <item android:top="125dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#44D9A066" />
        </shape>
    </item>

</layer-list>