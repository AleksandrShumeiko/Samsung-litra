<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp"
    android:background="@drawable/wood_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/urlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D8B878"
        android:padding="8dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Название стихотворения или ссылка"
            android:singleLine="true"
            android:textColor="#000000"
            android:textColorHint="#555555"
            android:background="#E6C993"
            android:backgroundTint="#E6C993"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <Button
            android:id="@+id/searchMenuButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▼ Поиск"
            android:textColor="#000000"
            android:backgroundTint="#E6C993"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/timerScoreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Время: 00:00:00 | Балл: 100/100 | Скрыто: 0/0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/poemScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:background="#E6C993"
        android:fillViewport="true">

        <EditText
            android:id="@+id/poemEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6C993"
            android:backgroundTint="#E6C993"
            android:gravity="top|start"
            android:hint="Здесь будет отображаться текст стиха"
            android:textColorHint="#555555"
            android:textColor="#000000"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="flagNoExtractUi"
            android:minHeight="150dp"
            android:padding="12dp"
            android:textSize="16sp" />

    </ScrollView>

    <Button
        android:id="@+id/actionsMenuButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="▲ Действия"
        android:textColor="#000000"
        android:backgroundTint="#E6C993" />

</LinearLayout>