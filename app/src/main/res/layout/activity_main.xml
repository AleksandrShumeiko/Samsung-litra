<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/urlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Вставьте ссылку с ilibrary.ru или culture.ru"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="15sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/loadInternetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Загрузить стих" />

    </LinearLayout>

    <TextView
        android:id="@+id/timerScoreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Время: 00:00:00 | Балл: 100/100"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:id="@+id/poemScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <EditText
            android:id="@+id/poemEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:minLines="20"
            android:textSize="18sp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:singleLine="false"
            android:overScrollMode="always"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:hint="Здесь будет стих..." />

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/nextStageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Следующий этап" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сохранить" />

        <Button
            android:id="@+id/checkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Проверить" />

    </LinearLayout>

</LinearLayout>